# Copy to .env and override locally as needed. .env is gitignored.

# Override the raw data directory if your Last.fm files live elsewhere.
LASTFM_RAW_DIR=data/raw

# Port for the FastAPI service (api/main.py).
API_PORT=8000

# --- Serving the pre-fitted EASE matrix -------------------------------------
# Leave EASE_B_URL unset locally: src/serving.py then fits EASE on demand and
# caches it to data/processed/lastfm360k/ease_B.npy, which is the normal dev
# loop. Set it in a deployment so the container fetches the 514 MiB artifact
# instead of spending ~85-100 s and ~2.5-3 GB refitting it.
# EASE_B_URL=https://huggingface.co/<you>/sonic-ease-360k/resolve/main/ease_B.npy
# EASE_B_SHA256=2ab7e37dab346cd88b7c36a3b218756f9382de1bc28bbf138ea0eeb431709b37
# EASE_B_BYTES=538889924
# Download here and symlink into place (Fly mounts a persistent volume at this
# path so the artifact survives restarts).
# EASE_B_CACHE_DIR=/artifacts

# Port for the container entrypoint (Fly sets this).
# PORT=8000
