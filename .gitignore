# Data — raw + bulky artifacts are NOT committed (raw is re-downloadable).
# But we DO commit the small processed 360K matrix (~7.5 MB) so the hosted app
# can run without the 2.1 GB raw dump or the 514 MiB EASE cache.
#
# NOTE (2026-08-28): an earlier version of this comment said EASE "refits at
# startup in ~15 s". Measured, the refit is ~85-100 s and ~2.5-3 GB peak
# (11,607^2 inverse ≈ 1.04e12 FLOPs at 10-12 GFLOP/s, BLAS pinned to 1 thread).
# The Streamlit app can absorb that on HF's 16 GB tier; the containerised API
# cannot, so it fetches the pre-fitted matrix at boot instead. See decisions.md
# 2026-08-28 and scripts/fetch_ease_b.py.
data/raw/
data/raw_360k/
data/interim/
data/processed/*
!data/processed/lastfm360k
!data/processed/harness
data/processed/lastfm360k/*
!data/processed/lastfm360k/matrix.npz
!data/processed/lastfm360k/item_ids.parquet
!data/processed/lastfm360k/user_ids.parquet
data/processed/harness/*
!data/processed/harness/_LOCKED_holdout
data/processed/harness/_LOCKED_holdout/*
!data/processed/harness/_LOCKED_holdout/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv*/
venv*/
env/
*.egg-info/
.pytest_cache/

# Notebooks
.ipynb_checkpoints/

# Outputs — keep the dirs, ignore bulky artifacts
outputs/figures/*
outputs/experiments/*
outputs/logs/
outputs/runs/
!outputs/**/.gitkeep
# The search history is a portfolio artifact — keep it tracked.
!outputs/experiments/log.jsonl

# Quarto report — keep the source (.qmd/.scss/figures), ignore the render + cache
report/_site/
report/.quarto/

# Env / OS
.env
.DS_Store
Thumbs.db
